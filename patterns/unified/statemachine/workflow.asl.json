{
    "Comment": "Unified IDP Document Processing Workflow - routes between BDA and step-by-step pipeline based on use_bda config flag",
    "StartAt": "RouteByProcessingMode",
    "States": {
        "RouteByProcessingMode": {
            "Type": "Choice",
            "Comment": "Route to BDA or step-by-step pipeline based on use_bda flag in document config",
            "Choices": [
                {
                    "Variable": "$.document.use_bda",
                    "BooleanEquals": true,
                    "Next": "BDA_CheckExistingData"
                }
            ],
            "Default": "OCRStep"
        },
        "BDA_CheckExistingData": {
            "Type": "Choice",
            "Comment": "Check if document already has pages/sections data (reprocessing scenario)",
            "Choices": [
                {
                    "And": [
                        {
                            "Variable": "$.document.num_pages",
                            "NumericGreaterThan": 0
                        },
                        {
                            "Variable": "$.document.sections[0]",
                            "IsString": true
                        }
                    ],
                    "Comment": "Document has existing data with string section IDs - skip BDA invocation",
                    "Next": "BDA_ProcessResultsSkip"
                },
                {
                    "And": [
                        {
                            "Variable": "$.document.num_pages",
                            "NumericGreaterThan": 0
                        },
                        {
                            "Variable": "$.document.sections[0].section_id",
                            "IsPresent": true
                        }
                    ],
                    "Comment": "Document has existing data with section objects - skip BDA invocation",
                    "Next": "BDA_ProcessResultsSkip"
                }
            ],
            "Default": "BDA_InvokeDataAutomation"
        },
        "BDA_InvokeDataAutomation": {
            "Type": "Task",
            "Resource": "arn:${Partition}:states:::lambda:invoke.waitForTaskToken",
            "Parameters": {
                "FunctionName": "${InvokeBDALambdaArn}",
                "Payload": {
                    "taskToken.$": "$$.Task.Token",
                    "execution_arn.$": "$$.Execution.Id",
                    "working_bucket": "${WorkingBucket}",
                    "BDAProjectArn.$": "$.document.bda_project_arn",
                    "document.$": "$.document"
                }
            },
            "ResultPath": "$.BDAResponse",
            "Retry": [
                {
                    "ErrorEquals": [
                        "Lambda.ServiceException",
                        "Lambda.SdkClientException",
                        "Lambda.TooManyRequestsException",
                        "ServiceQuotaExceededException",
                        "ThrottlingException",
                        "ProvisionedThroughputExceededException",
                        "RequestLimitExceeded",
                        "ServiceUnavailableException"
                    ],
                    "IntervalSeconds": 10,
                    "MaxAttempts": 8,
                    "BackoffRate": 2.5
                }
            ],
            "Next": "BDA_ProcessResultsStep",
            "Catch": [
                {
                    "ErrorEquals": [
                        "States.ALL"
                    ],
                    "Next": "FailState"
                }
            ]
        },
        "BDA_ProcessResultsStep": {
            "Type": "Task",
            "Resource": "${BDAProcessResultsLambdaArn}",
            "Parameters": {
                "execution_arn.$": "$$.Execution.Id",
                "output_bucket": "${OutputBucket}",
                "BDAResponse.$": "$.BDAResponse"
            },
            "ResultPath": "$.Result",
            "Retry": [
                {
                    "ErrorEquals": [
                        "Lambda.ServiceException",
                        "Lambda.AWSLambdaException",
                        "Lambda.SdkClientException",
                        "Lambda.TooManyRequestsException",
                        "ServiceQuotaExceededException",
                        "ThrottlingException",
                        "ProvisionedThroughputExceededException",
                        "RequestLimitExceeded",
                        "ServiceUnavailableException"
                    ],
                    "IntervalSeconds": 10,
                    "MaxAttempts": 8,
                    "BackoffRate": 2.5
                }
            ],
            "Next": "CheckHITLRequired"
        },
        "BDA_ProcessResultsSkip": {
            "Type": "Task",
            "Comment": "Process existing document data without BDA invocation (reprocessing scenario)",
            "Resource": "${BDAProcessResultsLambdaArn}",
            "Parameters": {
                "execution_arn.$": "$$.Execution.Id",
                "output_bucket": "${OutputBucket}",
                "skip_bda": true,
                "document.$": "$.document"
            },
            "ResultPath": "$.Result",
            "Retry": [
                {
                    "ErrorEquals": [
                        "Lambda.ServiceException",
                        "Lambda.AWSLambdaException",
                        "Lambda.SdkClientException",
                        "Lambda.TooManyRequestsException",
                        "ServiceQuotaExceededException",
                        "ThrottlingException",
                        "ProvisionedThroughputExceededException",
                        "RequestLimitExceeded",
                        "ServiceUnavailableException"
                    ],
                    "IntervalSeconds": 10,
                    "MaxAttempts": 8,
                    "BackoffRate": 2.5
                }
            ],
            "Next": "CheckHITLRequired"
        },
        "OCRStep": {
            "Type": "Task",
            "Resource": "${OCRFunctionArn}",
            "Parameters": {
                "execution_arn.$": "$$.Execution.Id",
                "document.$": "$.document"
            },
            "ResultPath": "$.OCRResult",
            "Retry": [
                {
                    "ErrorEquals": [
                        "Sandbox.Timedout",
                        "Lambda.ServiceException",
                        "Lambda.AWSLambdaException",
                        "Lambda.SdkClientException",
                        "Lambda.TooManyRequestsException",
                        "ServiceQuotaExceededException",
                        "ThrottlingException",
                        "ProvisionedThroughputExceededException",
                        "RequestLimitExceeded",
                        "ServiceUnavailableException"
                    ],
                    "IntervalSeconds": 10,
                    "MaxAttempts": 8,
                    "BackoffRate": 2.5
                }
            ],
            "Next": "PostOcrHook"
        },
        "PostOcrHook": {
            "Type": "Task",
            "Resource": "arn:${Partition}:states:::lambda:invoke",
            "Parameters": {
                "FunctionName": "${PipelineHooksDispatcherLambdaArn}",
                "Payload": {
                    "hookPoint": "postOcr",
                    "executionArn.$": "$$.Execution.Id",
                    "document.$": "$.OCRResult.document"
                }
            },
            "ResultPath": "$.HookResults.postOcr",
            "Retry": [
                { "ErrorEquals": ["Lambda.ServiceException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"], "IntervalSeconds": 2, "MaxAttempts": 3, "BackoffRate": 2 }
            ],
            "Catch": [
                { "ErrorEquals": ["States.ALL"], "ResultPath": "$.HookResults.postOcr.error", "Next": "ClassificationStep" }
            ],
            "Next": "ClassificationStep"
        },
        "ClassificationStep": {
            "Type": "Task",
            "Resource": "${ClassificationFunctionArn}",
            "Parameters": {
                "execution_arn.$": "$$.Execution.Id",
                "OCRResult.$": "$.OCRResult"
            },
            "ResultPath": "$.ClassificationResult",
            "Retry": [
                {
                    "ErrorEquals": [
                        "Sandbox.Timedout",
                        "Lambda.ServiceException",
                        "Lambda.AWSLambdaException",
                        "Lambda.SdkClientException",
                        "Lambda.TooManyRequestsException",
                        "ServiceQuotaExceededException",
                        "ThrottlingException",
                        "ProvisionedThroughputExceededException",
                        "RequestLimitExceeded",
                        "ServiceUnavailableException"
                    ],
                    "IntervalSeconds": 10,
                    "MaxAttempts": 8,
                    "BackoffRate": 2.5
                }
            ],
            "Next": "PostClassificationHook"
        },
        "PostClassificationHook": {
            "Type": "Task",
            "Resource": "arn:${Partition}:states:::lambda:invoke",
            "Parameters": {
                "FunctionName": "${PipelineHooksDispatcherLambdaArn}",
                "Payload": {
                    "hookPoint": "postClassification",
                    "executionArn.$": "$$.Execution.Id",
                    "document.$": "$.ClassificationResult.document"
                }
            },
            "ResultPath": "$.HookResults.postClassification",
            "Retry": [
                { "ErrorEquals": ["Lambda.ServiceException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"], "IntervalSeconds": 2, "MaxAttempts": 3, "BackoffRate": 2 }
            ],
            "Catch": [
                { "ErrorEquals": ["States.ALL"], "ResultPath": "$.HookResults.postClassification.error", "Next": "ProcessSections" }
            ],
            "Next": "ProcessSections"
        },
        "ProcessSections": {
            "Type": "Map",
            "ItemsPath": "$.ClassificationResult.document.sections",
            "ItemSelector": {
                "execution_arn.$": "$$.Execution.Id",
                "document.$": "$.ClassificationResult.document",
                "section_id.$": "$$.Map.Item.Value"
            },
            "MaxConcurrency": 10,
            "Iterator": {
                "StartAt": "ExtractionPlanStep",
                "States": {
                    "ExtractionPlanStep": {
                        "Type": "Task",
                        "Resource": "${ShardRuntimeFunctionArn}",
                        "Parameters": {
                            "mode": "plan",
                            "execution_arn.$": "$.execution_arn",
                            "document.$": "$.document",
                            "section_id.$": "$.section_id"
                        },
                        "ResultPath": "$.ShardPlan",
                        "Retry": [
                            {
                                "ErrorEquals": [
                                    "Sandbox.Timedout",
                                    "Lambda.ServiceException",
                                    "Lambda.AWSLambdaException",
                                    "Lambda.SdkClientException",
                                    "Lambda.TooManyRequestsException",
                                    "ThrottlingException",
                                    "ServiceUnavailableException",
                                    "InternalServerException",
                                    "InternalServerError"
                                ],
                                "IntervalSeconds": 5,
                                "MaxAttempts": 6,
                                "BackoffRate": 2.0
                            }
                        ],
                        "Next": "ShardModeChoice"
                    },
                    "ShardModeChoice": {
                        "Type": "Choice",
                        "Choices": [
                            {
                                "Variable": "$.ShardPlan.shard_mode",
                                "BooleanEquals": true,
                                "Next": "ExtractionShardMap"
                            }
                        ],
                        "Default": "ExtractionStep"
                    },
                    "ExtractionShardMap": {
                        "Type": "Map",
                        "ItemProcessor": {
                            "ProcessorConfig": {
                                "Mode": "DISTRIBUTED",
                                "ExecutionType": "STANDARD"
                            },
                            "StartAt": "ShardExtractionStep",
                            "States": {
                                "ShardExtractionStep": {
                                    "Type": "Task",
                                    "Resource": "arn:${Partition}:states:::lambda:invoke",
                                    "Parameters": {
                                        "FunctionName": "${ShardRuntimeFunctionArn}",
                                        "Payload": {
                                            "mode": "shard",
                                            "execution_arn.$": "$.execution_arn",
                                            "document.$": "$.document",
                                            "section_id.$": "$.section_id",
                                            "shard_index.$": "$.shard_index"
                                        }
                                    },
                                    "OutputPath": "$.Payload",
                                    "Retry": [
                                        {
                                            "ErrorEquals": [
                                                "States.Timeout",
                                                "Lambda.Unknown",
                                                "Sandbox.Timedout",
                                                "Lambda.ServiceException",
                                                "Lambda.AWSLambdaException",
                                                "Lambda.SdkClientException",
                                                "Lambda.TooManyRequestsException",
                                                "ServiceQuotaExceededException",
                                                "ThrottlingException",
                                                "ProvisionedThroughputExceededException",
                                                "RequestLimitExceeded",
                                                "ServiceUnavailableException",
                                                "InternalServerException",
                                                "InternalServerError",
                                                "States.TaskFailed"
                                            ],
                                            "IntervalSeconds": 10,
                                            "MaxAttempts": 8,
                                            "BackoffRate": 2.0
                                        }
                                    ],
                                    "End": true
                                }
                            }
                        },
                        "ItemsPath": "$.ShardPlan.shards",
                        "ItemSelector": {
                            "execution_arn.$": "$.execution_arn",
                            "document.$": "$.document",
                            "section_id.$": "$.section_id",
                            "shard_index.$": "$$.Map.Item.Value.shard_index"
                        },
                        "MaxConcurrency": 5,
                        "ResultPath": "$.ShardResults",
                        "Next": "ExtractionMergeStep"
                    },
                    "ExtractionMergeStep": {
                        "Type": "Task",
                        "Resource": "${ShardRuntimeFunctionArn}",
                        "Parameters": {
                            "mode": "merge",
                            "execution_arn.$": "$.execution_arn",
                            "document.$": "$.document",
                            "section_id.$": "$.section_id"
                        },
                        "Retry": [
                            {
                                "ErrorEquals": [
                                    "States.Timeout",
                                    "Lambda.Unknown",
                                    "Sandbox.Timedout",
                                    "Lambda.ServiceException",
                                    "Lambda.AWSLambdaException",
                                    "Lambda.SdkClientException",
                                    "Lambda.TooManyRequestsException",
                                    "ThrottlingException",
                                    "ServiceUnavailableException",
                                    "InternalServerException",
                                    "InternalServerError"
                                ],
                                "IntervalSeconds": 10,
                                "MaxAttempts": 8,
                                "BackoffRate": 2.5
                            }
                        ],
                        "Next": "PostExtractionHook"
                    },
                    "ExtractionStep": {
                        "Type": "Task",
                        "Resource": "${ExtractionFunctionArn}",
                        "Retry": [
                            {
                                "ErrorEquals": [
                                    "States.Timeout",
                                    "Lambda.Unknown",
                                    "Sandbox.Timedout",
                                    "Lambda.ServiceException",
                                    "Lambda.AWSLambdaException",
                                    "Lambda.SdkClientException",
                                    "Lambda.TooManyRequestsException",
                                    "ServiceQuotaExceededException",
                                    "ThrottlingException",
                                    "ProvisionedThroughputExceededException",
                                    "RequestLimitExceeded",
                                    "ServiceUnavailableException",
                                    "InternalServerException",
                                    "InternalServerError"
                                ],
                                "IntervalSeconds": 10,
                                "MaxAttempts": 8,
                                "BackoffRate": 2.5
                            }
                        ],
                        "Next": "PostExtractionHook"
                    },
                    "PostExtractionHook": {
                        "Type": "Task",
                        "Resource": "arn:${Partition}:states:::lambda:invoke",
                        "Parameters": {
                            "FunctionName": "${PipelineHooksDispatcherLambdaArn}",
                            "Payload": {
                                "hookPoint": "postExtraction",
                                "executionArn.$": "$$.Execution.Id",
                                "document.$": "$.document",
                                "section.$": "$"
                            }
                        },
                        "ResultPath": "$.HookResults",
                        "Retry": [
                            { "ErrorEquals": ["Lambda.ServiceException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"], "IntervalSeconds": 2, "MaxAttempts": 3, "BackoffRate": 2 }
                        ],
                        "Catch": [
                            { "ErrorEquals": ["States.ALL"], "ResultPath": "$.HookResults.error", "Next": "AssessmentStep" }
                        ],
                        "Next": "AssessmentStep"
                    },
                    "AssessmentStep": {
                        "Type": "Task",
                        "Resource": "${AssessmentFunctionArn}",
                        "Parameters": {
                            "execution_arn.$": "$$.Execution.Id",
                            "document.$": "$.document",
                            "section_id.$": "$.section_id"
                        },
                        "ResultPath": "$",
                        "Retry": [
                            {
                                "ErrorEquals": [
                                    "States.Timeout",
                                    "Lambda.Unknown",
                                    "Sandbox.Timedout",
                                    "Lambda.ServiceException",
                                    "Lambda.AWSLambdaException",
                                    "Lambda.SdkClientException",
                                    "Lambda.TooManyRequestsException",
                                    "ServiceQuotaExceededException",
                                    "ThrottlingException",
                                    "ProvisionedThroughputExceededException",
                                    "RequestLimitExceeded",
                                    "ServiceUnavailableException"
                                ],
                                "IntervalSeconds": 10,
                                "MaxAttempts": 8,
                                "BackoffRate": 2.5
                            }
                        ],
                        "Next": "SectionComplete"
                    },
                    "SectionComplete": {
                        "Type": "Pass",
                        "End": true
                    }
                }
            },
            "ResultPath": "$.ExtractionResults",
            "Next": "Pipeline_ProcessResultsStep"
        },
        "Pipeline_ProcessResultsStep": {
            "Type": "Task",
            "Resource": "${PipelineProcessResultsLambdaArn}",
            "Parameters": {
                "execution_arn.$": "$$.Execution.Id",
                "ClassificationResult.$": "$.ClassificationResult",
                "ExtractionResults.$": "$.ExtractionResults"
            },
            "ResultPath": "$.Result",
            "Retry": [
                {
                    "ErrorEquals": [
                        "Sandbox.Timedout",
                        "Lambda.ServiceException",
                        "Lambda.AWSLambdaException",
                        "Lambda.SdkClientException",
                        "Lambda.TooManyRequestsException",
                        "ServiceQuotaExceededException",
                        "ThrottlingException",
                        "ProvisionedThroughputExceededException",
                        "RequestLimitExceeded",
                        "ServiceUnavailableException"
                    ],
                    "IntervalSeconds": 10,
                    "MaxAttempts": 8,
                    "BackoffRate": 2.5
                }
            ],
            "Next": "CheckHITLRequired"
        },
        "CheckRuleValidationEnabled": {
            "Type": "Choice",
            "Choices": [
                {
                    "Variable": "$.Result.rule_validation_enabled",
                    "BooleanEquals": true,
                    "Next": "PolicyClassificationStep"
                }
            ],
            "Default": "SetEmptyRuleValidationResult"
        },
        "PolicyClassificationStep": {
            "Type": "Task",
            "Resource": "${RuleValidationPolicyClassificationLambdaArn}",
            "Retry": [
                {
                    "ErrorEquals": [
                        "Sandbox.Timedout",
                        "Lambda.ServiceException",
                        "Lambda.AWSLambdaException",
                        "Lambda.SdkClientException",
                        "Lambda.TooManyRequestsException",
                        "ServiceQuotaExceededException",
                        "ThrottlingException",
                        "ProvisionedThroughputExceededException",
                        "RequestLimitExceeded",
                        "ServiceUnavailableException"
                    ],
                    "IntervalSeconds": 2,
                    "MaxAttempts": 6,
                    "BackoffRate": 2
                }
            ],
            "ResultPath": "$.PolicyClassificationResult",
            "Next": "CheckPolicyMatch"
        },
        "CheckPolicyMatch": {
            "Type": "Choice",
            "Choices": [
                {
                    "Variable": "$.PolicyClassificationResult.skip_rule_validation",
                    "BooleanEquals": true,
                    "Next": "SetSkippedRuleValidationResult"
                }
            ],
            "Default": "ProcessRuleValidationSections"
        },
        "SetSkippedRuleValidationResult": {
            "Type": "Pass",
            "Parameters": {
                "document.$": "$.PolicyClassificationResult.document"
            },
            "ResultPath": "$.RuleValidationOrchestrationResult",
            "Next": "SummarizationStep"
        },
        "SetEmptyRuleValidationResult": {
            "Type": "Pass",
            "Parameters": {
                "document.$": "$.Result.document"
            },
            "ResultPath": "$.RuleValidationOrchestrationResult",
            "Next": "SummarizationStep"
        },
        "ProcessRuleValidationSections": {
            "Type": "Map",
            "ItemsPath": "$.PolicyClassificationResult.document.sections",
            "ItemSelector": {
                "execution_arn.$": "$$.Execution.Id",
                "document.$": "$.PolicyClassificationResult.document",
                "section_id.$": "$$.Map.Item.Value"
            },
            "MaxConcurrency": 10,
            "Iterator": {
                "StartAt": "RuleValidationStep",
                "States": {
                    "RuleValidationStep": {
                        "Type": "Task",
                        "Resource": "${RuleValidationLambdaArn}",
                        "Retry": [
                            {
                                "ErrorEquals": [
                                    "Sandbox.Timedout",
                                    "Lambda.ServiceException",
                                    "Lambda.AWSLambdaException",
                                    "Lambda.SdkClientException",
                                    "Lambda.TooManyRequestsException",
                                    "ServiceQuotaExceededException",
                                    "ThrottlingException",
                                    "ProvisionedThroughputExceededException",
                                    "RequestLimitExceeded",
                                    "ServiceUnavailableException"
                                ],
                                "IntervalSeconds": 10,
                                "MaxAttempts": 8,
                                "BackoffRate": 2.5
                            }
                        ],
                        "Next": "RuleValidationSectionComplete"
                    },
                    "RuleValidationSectionComplete": {
                        "Type": "Pass",
                        "End": true
                    }
                }
            },
            "ResultPath": "$.RuleValidationResults",
            "Next": "RuleValidationOrchestration"
        },
        "RuleValidationOrchestration": {
            "Type": "Task",
            "Resource": "${RuleValidationOrchestrationLambdaArn}",
            "Retry": [
                {
                    "ErrorEquals": [
                        "Lambda.ServiceException",
                        "Lambda.AWSLambdaException",
                        "Lambda.SdkClientException",
                        "Lambda.TooManyRequestsException",
                        "ServiceQuotaExceededException",
                        "ThrottlingException",
                        "ProvisionedThroughputExceededException",
                        "RequestLimitExceeded",
                        "ServiceUnavailableException"
                    ],
                    "IntervalSeconds": 10,
                    "MaxAttempts": 8,
                    "BackoffRate": 2.5
                }
            ],
            "ResultPath": "$.RuleValidationOrchestrationResult",
            "Next": "PostRuleValidationHook"
        },
        "PostRuleValidationHook": {
            "Type": "Task",
            "Resource": "arn:${Partition}:states:::lambda:invoke",
            "Parameters": {
                "FunctionName": "${PipelineHooksDispatcherLambdaArn}",
                "Payload": {
                    "hookPoint": "postRuleValidation",
                    "executionArn.$": "$$.Execution.Id",
                    "document.$": "$.RuleValidationOrchestrationResult.document"
                }
            },
            "ResultPath": "$.HookResults.postRuleValidation",
            "Retry": [
                { "ErrorEquals": ["Lambda.ServiceException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"], "IntervalSeconds": 2, "MaxAttempts": 3, "BackoffRate": 2 }
            ],
            "Catch": [
                { "ErrorEquals": ["States.ALL"], "ResultPath": "$.HookResults.postRuleValidation.error", "Next": "SummarizationStep" }
            ],
            "Next": "SummarizationStep"
        },
        "CheckHITLRequired": {
            "Type": "Choice",
            "Choices": [
                {
                    "Variable": "$.Result.hitl_triggered",
                    "BooleanEquals": true,
                    "Next": "MarkHITLPending"
                }
            ],
            "Default": "CheckRuleValidationEnabled"
        },
        "MarkHITLPending": {
            "Type": "Pass",
            "Comment": "Document marked for async HITL review, workflow continues without waiting",
            "Next": "CheckRuleValidationEnabled"
        },
        "SummarizationStep": {
            "Type": "Task",
            "Resource": "${SummarizationLambdaArn}",
            "Parameters": {
                "execution_arn.$": "$$.Execution.Id",
                "document.$": "$.RuleValidationOrchestrationResult.document"
            },
            "ResultPath": "$.Result",
            "OutputPath": "$.Result.document",
            "Retry": [
                {
                    "ErrorEquals": [
                        "Sandbox.Timedout",
                        "Lambda.ServiceException",
                        "Lambda.AWSLambdaException",
                        "Lambda.SdkClientException",
                        "Lambda.TooManyRequestsException",
                        "ServiceQuotaExceededException",
                        "ThrottlingException",
                        "ProvisionedThroughputExceededException",
                        "RequestLimitExceeded",
                        "ServiceUnavailableException"
                    ],
                    "IntervalSeconds": 10,
                    "MaxAttempts": 8,
                    "BackoffRate": 2.5
                }
            ],
            "Next": "PostSummarizationHook"
        },
        "PostSummarizationHook": {
            "Type": "Task",
            "Resource": "arn:${Partition}:states:::lambda:invoke",
            "Parameters": {
                "FunctionName": "${PipelineHooksDispatcherLambdaArn}",
                "Payload": {
                    "hookPoint": "postSummarization",
                    "executionArn.$": "$$.Execution.Id",
                    "document.$": "$"
                }
            },
            "ResultPath": null,
            "Retry": [
                { "ErrorEquals": ["Lambda.ServiceException", "Lambda.SdkClientException", "Lambda.TooManyRequestsException"], "IntervalSeconds": 2, "MaxAttempts": 3, "BackoffRate": 2 }
            ],
            "Catch": [
                { "ErrorEquals": ["States.ALL"], "ResultPath": null, "Next": "EvaluationStep" }
            ],
            "Next": "EvaluationStep"
        },
        "EvaluationStep": {
            "Type": "Task",
            "Resource": "${EvaluationLambdaArn}",
            "Parameters": {
                "execution_arn.$": "$$.Execution.Id",
                "document.$": "$"
            },
            "ResultPath": "$",
            "Retry": [
                {
                    "ErrorEquals": [
                        "Sandbox.Timedout",
                        "Lambda.ServiceException",
                        "Lambda.AWSLambdaException",
                        "Lambda.SdkClientException",
                        "Lambda.TooManyRequestsException",
                        "ServiceQuotaExceededException",
                        "ThrottlingException",
                        "ProvisionedThroughputExceededException",
                        "RequestLimitExceeded",
                        "ServiceUnavailableException"
                    ],
                    "IntervalSeconds": 10,
                    "MaxAttempts": 8,
                    "BackoffRate": 2.5
                }
            ],
            "Next": "WorkflowComplete"
        },
        "WorkflowComplete": {
            "Type": "Pass",
            "End": true
        },
        "FailState": {
            "Type": "Fail",
            "Cause": "Workflow Failed",
            "Error": "WorkflowFailedException"
        }
    }
}
