# Exclude everything, then allow only what the build needs
*

# FAST framework
!autotune/fast-template/pyproject.toml
!autotune/fast-template/gateway/
!autotune/fast-template/tools/
!autotune/fast-template/patterns/strands-single-agent/
!autotune/fast-template/patterns/utils/

# AutoTune agent
!autotune/agent/pyproject.toml
!autotune/agent/idpac/
!autotune/agent/tools.py
!autotune/agent/code_interpreter_tools.py
!autotune/agent/pricing.py
!autotune/agent/state.py
!autotune/agent/hooks.py
!autotune/agent/prompt.md
!autotune/agent/skills/

# IDP CLI chain
!lib/idp_common_pkg/
!lib/idp_sdk/
!lib/idp_cli_pkg/

# Pricing data
!config_library/pricing.yaml

# Standard excludes within allowed dirs
**/__pycache__/
**/*.pyc
**/.venv/
**/node_modules/
**/.git/
