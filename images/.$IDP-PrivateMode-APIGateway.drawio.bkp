        <mxCell id="apigw" value="Private REST API (stage: /api)&lt;br&gt;GET /            -&amp;gt; S3 proxy -&amp;gt; index.html&lt;br&gt;GET /{proxy+}    -&amp;gt; S3 proxy -&amp;gt; WebUI bucket&lt;br&gt;POST /op/{field} -&amp;gt; Lambda dispatcher&amp;nbsp;&lt;div&gt;(Cognito-authed)&lt;br&gt;Resource policy pinned to ApiGatewayVpcEndpointId&lt;/div&gt;" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];html=1;whiteSpace=wrap;fillColor=#F2F2F2;strokeColor=#CD2264;fontColor=#232F3E;verticalAlign=top;align=left;spacingLeft=6;fontSize=11;arcSize=6;" parent="1" vertex="1">
