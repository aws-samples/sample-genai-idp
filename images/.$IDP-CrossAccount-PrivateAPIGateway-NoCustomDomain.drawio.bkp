        <mxCell id="resource-policy-note" value="Resource policy (CloudFormation-generated):&#xa;Allow execute-api:Invoke&#xa;WHERE aws:SourceVpce = ApiGatewayVpcEndpointId&#xa;&#xa;Driven entirely by the ApiGatewayVpcEndpointId&#xa;stack parameter — set once per environment,&#xa;auto-applied on every deploy. No manual edit." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1">
          <mxGeometry x="940" y="138" width="330" height="110" as="geometry" />
        </mxCell>
