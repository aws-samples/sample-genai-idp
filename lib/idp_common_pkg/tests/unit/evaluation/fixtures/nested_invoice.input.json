{
  "description": "Nested invoice-style doc: top-level fields + LineItems array with configured match_threshold. Baseline: match_threshold at array level (R2 will move it to items schema).",
  "section_id": "invoice-42",
  "classification": "Invoice",
  "page_ids": ["1", "2"],
  "config": {
    "classes": [
