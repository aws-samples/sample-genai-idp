{
  "name": "@idp-accelerator/idp-monitor-ui",
  "version": "0.1.0",
  "description": "IDPMonitor UI library — React components, hooks, and types for the IDP monitoring dashboard",
  "private": true,
  "type": "module",
  "main": "./dist/idp-monitor-ui.umd.cjs",
  "module": "./dist/idp-monitor-ui.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/idp-monitor-ui.js",
      "require": "./dist/idp-monitor-ui.umd.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "build:types": "tsc --emitDeclarationOnly --outDir dist",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx"
  },
  "peerDependencies": {
    "@cloudscape-design/collection-hooks": "^1.0.0",
    "@cloudscape-design/components": "^3.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "@cloudscape-design/collection-hooks": "^1.0.91",
    "@cloudscape-design/components": "^3.0.1285",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.4.0",
    "vite": "^5.4.0",
    "vite-plugin-dts": "^4.0.0"
  },
  "dependencies": {
    "recharts": "^2.12.0"
  }
}
